# Copy to `.env.local` for local development.
# For the live Cloudflare deploy, put the SAME two values in a committed
# `.env.production` (see README: the CI workflow cannot inject env vars).
#
# Both values are PUBLIC by design: they ship in the browser bundle and are
# protected by Row Level Security. NEVER put the service_role / secret key here —
# the app refuses to start if it detects one.

# Supabase dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> anon (legacy) or publishable key
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
